(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

{$API_DOMAIN:api.localhost} {
	import common
	@metrics path /metrics
	respond @metrics 404
	reverse_proxy api:8000
}

{$GRAFANA_DOMAIN:grafana.localhost} {
	import common
	reverse_proxy grafana:3000
}
