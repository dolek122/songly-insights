# Copy to .env and adjust if needed. Never commit .env.
DATABASE_URL=postgresql+psycopg://songly:songly@localhost:5432/insights
# Used only by pytest. The database is created by docker compose.
TEST_DATABASE_URL=postgresql+psycopg://songly:songly@localhost:5432/insights_test
# Pipeline: contact info sent to MusicBrainz and ListenBrainz in the User-Agent
# (e-mail or project URL).
MUSICBRAINZ_CONTACT=

# Docker deployment (docker compose --profile full). Change all of these on a server!
POSTGRES_PASSWORD=songly
GRAFANA_DB_PASSWORD=grafana
GRAFANA_ADMIN_PASSWORD=admin
# Image to run; CI publishes ghcr.io/<owner>/songly-insights:<tag>
SONGLY_IMAGE=songly-insights:local
PIPELINE_CRON=15 3 * * *
